{
  "name": "lan-house-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "serve": "node scripts/serve.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:annual": "npm run build && node --test tests/annual-monthly-pricing-pressure.test.mjs",
    "audit:hardware": "npm run build && node --test tests/annual-hardware-payback.test.mjs",
    "audit:targeted": "npm run build && node --test tests/targeted-vip-lcd-roi.test.mjs",
    "build:site": "node website/build.mjs",
    "check:site": "node website/check.mjs",
    "audit:historical": "npm run build && LHS_HISTORICAL_AUDIT=1 node --test tests/historical-campaign-audit.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
