{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "game-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/game-ui",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": [
              "src/workspace.css"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "none",
              "sourceMap": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "site-shell": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src/site",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/site-shell",
            "index": "src/site/index.html",
            "browser": "src/site/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.site.json",
            "assets": [],
            "styles": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "none",
              "sourceMap": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "site-rewrite": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src/site-rewrite",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/site-rewrite",
            "index": "src/site-rewrite/index.html",
            "browser": "src/site-rewrite/main.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.site-rewrite.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/site-rewrite/public",
                "output": "/"
              }
            ],
            "styles": [
              "src/site-rewrite/site.css"
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "outputHashing": "all",
              "sourceMap": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "outputHashing": "none",
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
